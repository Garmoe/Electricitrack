@model ELECTRICITRACK.Models.HouseholdSettings
@{
    ViewData["Title"] = "Household settings";
}

<section class="page-heading">
    <div>
        <h1>Household settings</h1>
        <p>Set the electricity rate and monthly budget used in your estimates.</p>
    </div>
</section>
<section class="card settings-card">
    <h2>Electricity and budget</h2>
    <p class="muted">Use the rate shown on your electricity bill. These values apply to all appliance estimates.</p>
    <form asp-action="Save" method="post" class="settings-form">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="form-field">
            <label asp-for="ElectricityRatePerKwh">Electricity rate</label>
            <div class="input-with-unit">
                <input asp-for="ElectricityRatePerKwh" type="number" min="0.01" step="0.01" />
                <span>₱ / kWh</span>
            </div>
            <span asp-validation-for="ElectricityRatePerKwh" class="field-error"></span>
            <span class="field-help">Your electricity provider’s rate per kilowatt-hour.</span>
        </div>
        <div class="form-field">
            <label asp-for="MonthlyBudget">Monthly electricity budget</label>
            <div class="input-with-unit">
                <input asp-for="MonthlyBudget" type="number" min="0.01" step="0.01" />
                <span>₱ / month</span>
            </div>
            <span asp-validation-for="MonthlyBudget" class="field-error"></span>
            <span class="field-help">Used by the simulator to estimate a daily-hours target.</span>
        </div>
        <div class="form-actions">
            <span></span>
            <div class="button-row">
                <a class="button button-secondary" asp-controller="Dashboard" asp-action="Index">Cancel</a>
                <button class="button button-primary" type="submit">Save settings</button>
            </div>
        </div>
    </form>
</section>
<p class="footnote">
    <svg class="info-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
    Cost calculations are estimates; provider fees, taxes, and other bill adjustments may not be included.
</p>
